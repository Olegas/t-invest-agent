# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY="sk-..."

# Raw T-Bank Invest MCP token. The `Authorization: Bearer <token>` header is
# assembled by opencode.json, so do NOT include the "Bearer " prefix here.
TINVEST_MCP_TOKEN="<token>"

# Password for the opencode HTTP server. Required: opencode v2 refuses
# unauthenticated requests. Clients connect with HTTP Basic auth using the
# username "opencode" and this value as the password.
OPENCODE_PASSWORD="<pick-a-long-random-password>"
